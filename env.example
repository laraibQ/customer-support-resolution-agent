# Default: Groq (free tier) + fast TF-IDF RAG (no Torch cold-start)
# Copy to .env and fill in secrets. Never commit .env.

LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
EMBED_BACKEND=tfidf

# --- OpenAI (optional) ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# EMBED_BACKEND=openai
# OPENAI_EMBED_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=

# --- Nebius (optional; pip install -e ".[nebius]") ---
# LLM_PROVIDER=nebius
# NEBIUS_API_KEY=your_nebius_token_factory_api_key
# NEBIUS_MODEL=Qwen/Qwen3-30B-A3B
# EMBED_BACKEND=nebius
# NEBIUS_EMBED_MODEL=Qwen/Qwen3-Embedding-8B

# --- Optional FAISS + local HF embeddings (pip install -e ".[faiss]") ---
# EMBED_BACKEND=local
# LOCAL_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
