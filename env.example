# Default: Groq + TF-IDF (fast local demos)
# Copy to .env — never commit .env

LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
RETRIEVAL_BACKEND=tfidf

# Optional OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# RETRIEVAL_BACKEND=tfidf
